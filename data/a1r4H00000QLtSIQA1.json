// This configuration activates all features (as much as possible)
// Currently it serves as "the variant" against regression is tested
// New ways to config needs to be added here
[
  {
    // --------------------------------------------------------------------------------
    //
    // General Custom (System) Settings
    //
    "type": "customSettings",
    "values": {
      "debug": "0",
      "debug.tracelevel": "3",
      // See service1-mobile-common\source\utils\logging\LoggingConfiguration.d.ts and related for allowed values.
      "logging": {
        // see @LoggingTag for supported values, e.g. Module.Common, Module.Legacy, Package.Standard....
        "enabledTags": [
          "*" // all tags
        ],
        "formatting": {
          "arrayStyle": "stringify", // fallback: 'stringify', 'flatten'
          "formatJSON": {
            // false or {indentation: number} -> fallback is false
            "indentation": 2
          }
        },
        "minimumSeverity": 3 // 1 <=> verbose, 2 <=> debug, 3 <=> info, 4 <=> warning, 5 <=> critical
      },
      "basic": {
        "barcode": {
          "formats": [
            // all possible (supported) barcode Formats (see BARCODE_FORMATS_ALL)
            "AZTEC",
            "CODABAR",
            "CODE_39",
            "CODE_93",
            "CODE_128",
            "DATA_MATRIX",
            "EAN_8",
            "EAN_13",
            "ITF",
            "MAXICODE",
            "PDF_417",
            "QR_CODE",
            "RSS_14",
            "RSS_EXPANDED",
            "UPC_A",
            "UPC_E",
            "UPC_EAN_EXTENSION",
            "MSI",
            "PLESSEY",
            "IMB"
          ]
        },
        "block": {
          "material": {
            // avoid using part without articledetail per country (of technican) although it is shown
            //
            "country": [
              true
            ]
          }
        },
        // hide buttons on detail page: "RETURN", "TRANSFER", "ORDER"
        // order(line) related operation e.g. 'Order Material' (ORDER),
        //   'Reserved parts next appointment'
        //   (ORDERLINE_PROPOSAL) or show quotation lines (ORDERLINE_QUOTATION)
        // For material source: 'customerOwned'
        //  Hide stock types: 'stock.type=' with given stock type after = to hide these types
        //  For stock type: 'MobileStock', SparePartsCentral', 'Others'
        //  Do not show stocks with other plants then engineers stock has: 'otherPlants'
        // For no alert on missing stock: 'missingPart'
        // Set 'stock.source.default=customerOwned' to have 'customerOwned' as default for material source, instead of standard 'engineerStock'
        "hide_material_operation": [
          /*
          // StockModule - Button in StockItemDetails (TRANSFER, ORDER, RETURN)
          "TRANSFER",
          "ORDER",
          "RETURN",
          // hide tags for
          "missingPart",
          "joblist.tag.partsOrdered",
          // hide stock for consumption by type
          "customerOwned",
          "stock.source.default=customerOwned", // set 'customerOwned' as default for material source (not active if "customerOwned" set)
          "stock.type=MobileStock",
          "stock.type=SparePartsCentral",
          "stock.type=Others",
          "otherPlants",                     
          "ORDERLINE_PROPOSAL"  // hide proposal. Since 05.2025 shopping card menu item to reserve/order parts is hidden too
          */
        ],
        "hide_pages": [
          "jobFastTrackTab",
          "outline.attachmentButton",
          "outline.newtonDocumentsButton",
          "OpenOnlinePageSalesforceServiceConsole",
          "OpenOnlinePageSalesforceDashboardView",
          "followUpAppointmentComponents.editPage",
          "OpenOnlinePageFollowUpAppointment"
        ],
        "modules": [
          "jobs",
          "timesheet",
          // simpler Version with clock-in, clock-out
          //"timesheetbasic",
          "material",
          "resourceEquipmentView",
          "online",
          // configuration/setup "paste JSON" / with active "debug" always shown
          "setup",
          "notification"
        ],
        "tabs": {
          // Floating Action Button (FAB) and Quick Action Button (QAB) (T-25262):
          // "part", "times", "service", "attachments", "checklist", "repaircodes", "service_item"  Default: all FAB are active.
          "fab": [
            "part",
            "times",
            "service",
            "attachments",
            "checklist",
            "repaircodes",
            "service_item"
          ],
          // Enable legacy (search bar always shown) (T-25262): ["part", "service", "repaircodes", "service_item"]. Default: empty/deactive
          "legacy": {
            "add": []
          }
        },
        "view": {
          // hide prices overall
          "prices": [
            true
          ]
        }
      },
      "order": {
        "finish": {
          "followup": {
            //"mode": ["twoStep"], // only works for coke ? for other projects change 'finishFlowFollowUpSelectionImplementation' below at the end.
            // conclusion - cancelled
            "cancelled": [
              // -> default
              "2902",
              "2915"
              // <- default
            ],
            // conclusion - completed
            "completed": [
              // -> default
              "2901",
              "2902",
              "2903",
              "2904",
              "2905",
              "2915",
              "2950",
              "2951",
              "2952",
              "2953",
              "2954",
              "2955"
              // <- default
            ],
            // conclusion - rejected
            "rejected": [
              // -> default
              "2903"
              // <- default
            ],
            "supportcompleted": [
              // -> default
              "2902",
              "2903",
              "2915",
              "2957"
              // <- default
            ]
          },
          "hide": [
            ""
          ], //e.g ["invoice"] => hide invoice step in finish flow, unconditionally
          "wizard": {
            "saveonback": "1"
          }
        }
      },
      "parts": {
        "search": {
          // show fields in article result list
          "fields": [
            // "listprice" --> deprecated due to priceCalculation / shown in OrderLineEditPage
            "serialized",
            "articlesearch",
            "class",
            "type"
          ]
        }
      },
      "services": {
        "search": {
          // show fields in article result list
          "fields": [
            // "listprice" --> deprecated due to priceCalculation / shown in OrderLineEditPage
            "serialized",
            "articlesearch",
            "class",
            "type"
          ]
        }
      },
      "view": {
        "filter": {
          "job_list": [
            "currentJob",
            "today",
            "tonight",
            "tomorrow",
            "nextSevenDays",
            "lastSevenDays",
            "yesterday",
            "notCompleted",
            "completed",
            "all",
            "preCheck",
            "preChecked"
          ],
          "jobs": {
            // check for empty lists and take fallback
            "fallback": [
              "currentJob",
              "today",
              "notCompleted"
            ]
          },
          // master solution - blacklist
          "resource_appointment_types_hidden": [
            // default only hide breaks
            "7404"
          ],
          // original product solution - whitelist
          "resource_appointment_types_to_show": [
            "7449"
          ]
        },
        "ib": {
          "fields": [
            // switch to name instead of description (text_de, ...)
            "xx-productmodel.name",
            "serialno.trim",
            "idext",
            "building",
            "floor",
            "room",
            "name"
          ]
        },
        "job": {
          // list of status to hide appointments with this status in some filters. Suggested value: "5507" cancelled/storniert
          "hide_status": [],
          "important": {
            // Name of checklists shown as cards on separate Tab (importantChecklistTabTabExtension)
            "checklists": []
          }
        },
        "jobheader": {
          // default: ["AP.startend", "SR.name"] (default also actived if only 1 field is defined)
          // additional or other fields in Job Header:
          // ["ORD.type", "ORD.name", "IB.idext", "IB.idint", "IB.prodName"]
          // first field = line1, second field = line2 BOLD, other added to line2 delimted " • "
          // For backward compatibiliy: if 'view.order.fields' includes deprecated 'tab' it will be added as 'ORD.name'
          "fields": [
            "AP.startend",
            "SR.name"
          ]
        },
        "order": {
          "enable": {
            // field readonly
            "invoicing_type": [
              true
            ]
          },
          // deprecated: 'tab', use 'ORD.name' in jobheader
          // Note: remove or comment, any property below to disable it in the card. 
          "fields": [
            "tab", // ORD.Name #123 in Title of opened Job
            // Job Card Overview Details
            "name", // ORD.Name #123 in Job List
            "drivetime",
            "counterinfo",
            "errortext",
            "internalinfo",
            "description",
            "cardAdditionalCustomerInfo",
            "priority",
            "client",
            "tagAdditionalCustomerInfo",
            "tagInternalInfo",
            "tagDescription",
            "tagErrorText",
            //"customerWish",
            "tagCriticalHistory",
            "showProperties", // show properties in job card.
            "showRemarks" // show remarks in job card
          ],
          "search": [
            // activate search bar in ALL filter
            "#ON",
            // switch to new "inline" mode
            "#INLINE",
            // suppress filter in ALL view
            "!xx-all"
          ]
        },
        "orderitem": {
          "fields": [
            // in addition to room/building ...
            "errortext",
            "idint", // not yet included due to T-42918 
            "idext"
          ]
        },
        "orderline": {
          "edit": {
            // allow decimals for Qty / fallback if no fsoMaterialUnitQtyRules is defined
            // also used for discounts
            "qty_decimals": [
              // default
              2
            ]
          },
          "fields": [
            // default
            "invoicingtype",
            // show (selected) stock
            "stock",
            // special for BG1, stock used to identify technician (two-man-job)
            "stockservice"
          ]
        },
        // Stock Module
        "stockitem": {
          // list of status for booked movements
          "booked": {
            "status": [
              // default
              "5403",
              // default
              "5408"
            ]
          },
          // list of status for pending movements
          "pending": {
            "status": [
              // default
              "5402",
              // default
              "5407"
            ]
          }
        },
        "timereport": {
          // time tab/timesheet view: fields for time report entry/card
          // example values: ["IB.idext", "IB.idint", "IB.building", "IB.room", "IB.floor", "IB.serialno", "IB.serialno.trim", "type", "duration", "distanceInline", "ORD.name"]
          // deprecated: "appId", "ORD.name.footer", "ORD.account", "name", "start". Instead of "appId", "ORD.name.footer" use "ORD.name"
          // default (if not set): ["type", "mileage", "description", "duration", "distanceInline", "ORD.name"]
          "fields": [
            "type",
            "mileage",
            "description",
            "duration",
            "type",
            "distanceInline",
            "ORD.name",
            "compensationType"
          ]
        }
      }
    }
  },
  {
    // --------------------------------------------------------------------------------
    //
    // Timesheet / Timeedit
    // Some fields marked as @deprecated/unused since 2023.112
    //
    "type": "configTimeSheet",
    "values": {
      "break": {
        /**
        *"optional" is the default value if not configured and means the "old" behaviour, where the user decides if he enters breaks and they're not validated
        * "mandatory" means, that the user has to enter a break and that it's validated, that he does so
        */
        "breakType": "mandatory",
        /**
        * The amount of hours of work after break becomes mendatory
         */
        "breakMinMinutes": 30,
        /**
         * The minimum amoutn of breaks  after breakAfterHours working hours.
         */
        "breakAfterHours": 6
      },
      "overTime": {
        /**
     * "disabled" is the default value if not configured and means the "old" behavior, where the field is not displayed
     * "optional" means that the field is displayed, but the user decides if they enter an overtime reason and it's not validated
     * "mandatory" means that the field is displayed and the user has to enter an overtime reason, and it's validated, that they do so
     */
        "overtimeReason": "enable",
        /**
     * The limit after Overtime Reason becomes mandatory.
     */
        "overtimeReasonAfterHours": 10
      },
      "workingHoursRelatedCategories": {
        "type": "include",
        "values": [
          "work",
          "travel"
        ]
      },
      // time button at the end (not at top or FAB) or at top:"recommended" | "legacy"
      "addingTimesBehavior": "recommended",
      // which calendar day is visible in job tab: "today" | "lastTimeSheet"
      "calendarDayInJob": "lastTimeSheet",
      // allowed days in past for creating an open day, 0 = today (default), 5 = 5 days in the past, -1 = disabled (default 0)
      // works as expected (but mode must be 'strict')
      "clockInDays": 0,
      // "timesheet" -> On commit, all time entries of the timesheet are closed
      // "job" -> job-related time entries are closed when finishing a job. After a job is finished, no new times can be added to that job.
      "commit": "job",
      // allow only a date in month limit relative to today
      "dateMonthLimit": 1,
      // steps for + - buttons (only used for field DistanceOrMilageEdit)
      "distanceGrid": 1,
      // "distance" | "mileage" | "disable"
      "distanceTracking": "mileage",
      // true -> explicit day open is mandatory before creating a time report entry (startEndClockIn should be active). Additionally for today the actual time taken as suggested end time (if not less then start)
      "forceClockIn": false,
      // suggestion display mode in job tab: "off" | "legacy";
      "jobSuggestionMode": "off",
      // "timeCategories": "normal" | "jobwork" | "jobTravel" with arry of report types @deprecated, use fsoTimeReportTypes
      // "fsoTypes": configured report types, default empty. @deprecated, use fsoTimeReportTypes. Sample:
      // "jobSuggestionMode": "off", @deprecated
      // "shifts": 1, @deprecated
      // "whitelistedFollowUpCodes", still in use. Planned to be replaced by fsoFollowUp2Types.validate.timereport.types
      // "required"."description", @deprecated
      // enable/disable validations in job finish flow, default = 'on'
      "jobValidations": "on",
      // max gap length in hours / max hours per timesheet
      "maxTimesheetDuration": 24,
      // defines the rounding grid. 5,10,15 -> rounding to minutes
      "minuteGrid": 15,
      //toggle compensation type showing up in time reports
      "compensationType": "enable",
      // primary configuration modes: "simple" | "lenient" | "strict"
      "mode": "strict",
      // start and end time of timesheet is set "auto" | "manual"
      "startEnd": "auto",
      // 'list' -> device name is shown in a multiple lines
      // 'inline' -> device name is shown in a same line
      "timeReportEntryType": "list",
      // show device name in time report entry
      "enableDeviceSpecificTimeReporting": true,
      "allowEmptyDeviceSelection": true,
      "preventDevicePreselectionInJobContextOfSingleDeviceJobs": true,
      // "enable" | "disable" clockIn/clockOut buttons
      "startEndClockIn": "enable",
      // max gap size in hours
      "timesheetSplitDuration": 12,
      // max number of open time sheets for user. Min is 0 for deactivated (default). 1: Only one day can be open. Dates for other days are not possible to save, see T-27389
      "uncommittedTimeSheetLimit": 3,
      // uncommitedTimesMaxPeriod, defines for how many days in the past, the app should look and warn for open timesheets. Max: 30 days
      "uncommittedTimesMaxPeriod": 27,
      "activitiesAsTimeReportType": "combined"
    }
  },
  // --------------------------------------------------------------------------------
  //
  // Config for always showing the device list tab, even if there is a single orderItem.
  //
  {
    "type": "deviceListTabConfig",
    "values": {
      "showAlwaysDeviceList": true // show or hide devicelist tab even if there is a single orderItem, values: true, false, default <=> false
    }
  },
  // --------------------------------------------------------------------------------
  //
  // Config for always showing the Add Devices page.
  //
  {
    "type": "addDevicesConfig",
    "values": {
      "showAlways": true // show or hide AddDevices tab even if there is a single AddDevice, values: true, false, default <=> false
    }
  },
  // --------------------------------------------------------------------------------
  //
  // Config for enabling the use of partial proposals - MOB-42701
  // without setting this flag to true, the partial proposal feature is disabled
  //
  {
    "type": "PartialMaterialProposalConfig",
    "values": {
      "partialProposalsEnabled": true // enables partial proposal handling, values: true, false, default <=> false
    }
  },
  // --------------------------------------------------------------------------------
  //
  // Innotec : Activity Selection for parts/product is mandatory
  // PA FSM: Activity selection is optional for unplanned parts/products
  //
  {
    "type": "ActivitySelectionConfig",
    "values": {
      "isActivitySelectionOptional": true // enables activity selection, values: true, false, default <=> false
    }
  },
  // --------------------------------------------------------------------------------
  //
  // Config for notifications
  //
  {
    "type": "configNotification",
    "values": {
      // features "popup Notification" is implicitly used if backend creates MOBILE_POPUP_NOTIFICATION (SCMessage.Type)
      "popupNotifications": {
        "$default": {
          // convenient shortcut to define fallback values for properties for all events
          /** time frame configuration, starttime of appointment of notification is within this time frame
           * null <=> no time frame filter, 0 <=> show notification only if appointment is for today,
           * [-3, 2] <=> show notification if appointment is at least 3 days in the past or 2 days in the future */
          "displayDays": 0,
          /** messages older than this (unit days) are not considered, SCMessage.LastModifiedDate
           *  this applies additionally to further time frame based filtering
           *  0 <=> no limit on message age
           *  1 is default */
          "maxAgeInDays": 1
        },
        //
        // "AppointmentCancelled": {
        //   "displayDays": 0,
        //   "maxAgeInDays": 1
        // },
        // "AppointmentInserted": {
        //   "displayDays": 0,
        //   "maxAgeInDays": 1
        // }
        "mode": "enabled" // enables or disables the notifications, options : 'enabled' or 'disabled'
      }
    }
  },
  // --------------------------------------------------------------------------------
