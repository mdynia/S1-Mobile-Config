  // Config for Quotation
  //
  {
    "type": "quotation",
    "values": {
      // Config for quotation
      "jobFinishFlow": {
        "showSummaryCard": false, // true: show summary card in job finish flow, false: do not show summary card
        "ensureFinishJobWithValidQuotationStatus": true
      }
      //   "quotationFinishFlow": {
      //     // 'noSigning' | 'signAlways' | 'signAccepted'
      //     "customerSignature": "signAlways",
      //     // 'noSigning' | 'signAlways' | 'signAccepted'
